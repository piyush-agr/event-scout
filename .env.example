# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Any Gemini Flash model
GEMINI_MODEL=gemini-2.5-flash
# Supabase project URL and API key (used server-side only)
SUPABASE_URL=
SUPABASE_KEY=
# Gmail account that sends the digest + a Google "app password"
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Random string; Vercel Cron sends it as a Bearer token
CRON_SECRET=
